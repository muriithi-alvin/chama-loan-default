# Website address
SITE_ADDRESS=your-domain.example
WEB_ORIGINS=https://your-domain.example

# PostgreSQL
POSTGRES_USER=kibaba
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
POSTGRES_DB=kibaba

# Persistent Oracle VM directories
KIBABA_DATA_DIR=/opt/kibaba/data
KIBABA_RELEASE_DIR=/opt/kibaba/release

# Application security
PSEUDONYM_KEY=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_SECRET
DEMO_MODE=false
COOKIE_SECURE=true
SESSION_HOURS=12
TWO_STEP_FOR_OFFICIALS=true
PHONE_COUNTRY_CODE=254

# Supabase authentication
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Initial release accounts
RELEASE_OFFICIAL_EMAIL=
RELEASE_OFFICIAL_PHONE=
RELEASE_MEMBER_EMAIL=
RELEASE_MEMBER_PHONE=

# Photo extraction provider
GROQ_API_KEY=

# SMS integration (optional)
MEETING_TEXTS=false
SMS_HOOK_SECRET=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
