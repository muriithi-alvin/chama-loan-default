@startuml m1_progress
title Chama data pipeline - Milestone 1 progress (6 Oct 2026)\nAll steps built; runs end to end with  python -m chama.pipeline all
skinparam componentStyle rectangle
skinparam shadowing false

rectangle "Paper ledgers\n& minutes" as ledgers
rectangle "Photos\nChama B: 149 pages\n(2014 - Apr 2026)" as photos #palegreen
rectangle "Raw Excel\n2014 extracted: 12 of 149 pages\n167 statement rows, 22 loans\n30 rows flagged unclear" as excel #khaki

package "PostgreSQL (Docker)" {
  database "raw\n(as recorded,\nreal names)" as raw #palegreen
  database "private\n(name -> code,\nrestricted)" as priv #palegreen
  database "staging\n(codes, values\nas written)" as staging #palegreen
  database "analytics\n(clean tables, loans,\nquality report)" as analytics #palegreen
}

rectangle "Model training\n(Milestone 2)" as model

ledgers --> photos : photograph
photos --> excel : extract\n(Claude + human check)\n<i>2015 - 2026 still to extract</i>
excel --> raw : 1. ingest\n<b>built, 8 tests</b>
raw --> priv : 2. match names\n<b>built, 15 tests</b>\n<i>2014: 22 spellings -> 14 members</i>
raw --> staging : 3. anonymise\n<b>built, 21 tests</b>
priv ..> staging : name -> code
staging --> analytics : 4. clean, link loans, check (dbt)\n<b>built, 33 data + 3 unit tests</b>\n<i>2014: 47 loans, 1 warning</i>
analytics --> model : features

legend right
  |<#palegreen> Done |
  |<#khaki> In progress |
  |<#lightgray> Not started |
endlegend
@enduml
