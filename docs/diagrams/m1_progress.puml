@startuml m1_progress
title Chama data pipeline - Milestone 1 progress (6 Oct 2026)
skinparam componentStyle rectangle
skinparam shadowing false

rectangle "Paper ledgers\n& minutes" as ledgers
rectangle "Photos\nChama B: 149 pages\n(2014 - Apr 2026)" as photos #palegreen
rectangle "Raw Excel\n2014 extracted: 12 of 149 pages\n167 statement rows, 22 loans\n30 rows flagged unclear" as excel #khaki

package "PostgreSQL (Docker)" {
  database "raw\n(as recorded,\nreal names)" as raw #palegreen
  database "private\n(name -> code,\nrestricted)" as priv #khaki
  database "staging\n(codes, values\nas written)" as staging #khaki
  database "analytics\n(clean + features)" as analytics #lightgray
}

rectangle "Model training\n(Milestone 2)" as model

ledgers --> photos : photograph
photos --> excel : extract\n(Claude + human check)
excel --> raw : 1. ingest\n<b>built, 8 tests</b>
raw --> priv : 2. match names\n<b>built, 13 tests</b>\n<i>2014: 22 spellings -> 14 members,</i>\n<i>waiting for review</i>
raw --> staging : 3. anonymise\n<b>built, 21 tests</b>\n<i>runs once names are reviewed</i>
priv ..> staging : name -> code
staging --> analytics : 4. validate & clean\n<i>not started</i>
analytics --> model : features

legend right
  |<#palegreen> Done |
  |<#khaki> In progress |
  |<#lightgray> Not started |
endlegend
@enduml
