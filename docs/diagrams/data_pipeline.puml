@startuml data_pipeline
title Chama data pipeline (Milestone 1)
skinparam componentStyle rectangle

rectangle "Paper ledgers\n& minutes" as ledgers
rectangle "Photos\n(data/photos)" as photos
rectangle "Raw Excel\n(data/raw)" as excel

package "PostgreSQL" {
  database "raw\n(as recorded,\nreal names)" as raw
  database "private\n(name -> code,\nrestricted)" as priv
  database "staging\n(codes, typed)" as staging
  database "analytics\n(clean + features)" as analytics
}

ledgers --> photos : photograph
photos --> excel : extract\n(Claude + human check)
excel --> raw : 1. ingest
raw --> staging : 2. anonymise
priv ..> staging : name -> code
staging --> analytics : 3. validate & clean
analytics --> [Model training\n(Milestone 2)] : features
@enduml
