# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_USER=chama
POSTGRES_PASSWORD=
POSTGRES_DB=chama
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Secret key used to turn member names into codes.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_KEY=

# The project folder on Google Drive, as synced by Drive for desktop, e.g.
# DRIVE_DIR=G:/My Drive/chama-loan-default
# `export` writes the modelling table to its data/ folder and training logs
# MLflow runs to its mlruns/ folder. Left empty: data/processed and ./mlruns.
DRIVE_DIR=

# Keys for reading ledger photos (extract, extract-eval; D-025). Only the
# provider set in config/pipeline.yaml (extraction.provider) needs one.
# Groq, free plan (the default): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Claude API, paid (for comparison): https://platform.claude.com, under API keys
ANTHROPIC_API_KEY=

# ---- Web interface (Milestone 4, D-026, D-027) ----
# Sign-in with Supabase Auth (free plan); see docs/web_setup.md. Only the
# project URL and the publishable key (sb_publishable_..., or the legacy
# "anon public" key) are needed. Never put the secret or service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# true: fictional names for every real chama and no real ledger photo on any
# page (ground rule G5, D-028). Use it on any projector.
DEMO_MODE=false
# Where uploaded ledger photos are kept, outside every web folder. Empty:
# data/interim/uploads (private, never committed).
PHOTO_DIR=
# Leave true. Set false only to try the site from a phone over plain http on
# the local network (browsers refuse Secure cookies there).
COOKIE_SECURE=true
# The addresses the pages are opened from, comma-separated (changes from any
# other site are refused).
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# How long a sign-in lasts.
SESSION_HOURS=12

# ---- The cloud release (docs/deployment.md, D-032) ----
# Write token: lets deploy-publish create the dataset and Space.
HF_TOKEN=
# Read-only token: lets the Space's build fetch the private dataset.
HF_BUILD_TOKEN=
# GitHub fine-grained token, read-only, this repository only: lets the build clone the code.
GITHUB_READ_TOKEN=
# The release's own key, different from PSEUDONYM_KEY. Keep it once made.
CLOUD_PSEUDONYM_KEY=
# The Supabase sign-in emails of the release's demo official and member.
RELEASE_OFFICIAL_EMAIL=
RELEASE_MEMBER_EMAIL=
