# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_USER=chama
POSTGRES_PASSWORD=
POSTGRES_DB=chama
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Secret key used to turn member names into codes.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_KEY=

# The project folder on Google Drive, as synced by Drive for desktop, e.g.
# DRIVE_DIR=G:/My Drive/chama-loan-default
# `export` writes the modelling table to its data/ folder and training logs
# MLflow runs to its mlruns/ folder. Left empty: data/processed and ./mlruns.
DRIVE_DIR=

# Claude API key for reading ledger photos (extract, extract-eval; D-024).
# Create one at https://platform.claude.com, under API keys.
ANTHROPIC_API_KEY=
