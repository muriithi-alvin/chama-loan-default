# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_USER=chama
POSTGRES_PASSWORD=
POSTGRES_DB=chama
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Secret key used to turn member names into codes.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_KEY=

# The project folder on Google Drive, as synced by Drive for desktop, e.g.
# DRIVE_DIR=G:/My Drive/chama-loan-default
# `export` writes the modelling table to its data/ folder and training logs
# MLflow runs to its mlruns/ folder. Left empty: data/processed and ./mlruns.
DRIVE_DIR=

# Keys for reading ledger photos (extract, extract-eval; D-025). Only the
# provider set in config/pipeline.yaml (extraction.provider) needs one.
# Groq, free plan (the default): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Claude API, paid (for comparison): https://platform.claude.com, under API keys
ANTHROPIC_API_KEY=

# ---- Web interface (Milestone 4, D-026, D-027) ----
# Sign-in with Supabase Auth (free plan); see docs/web_setup.md. Only the
# project URL and the publishable key (sb_publishable_..., or the legacy
# "anon public" key) are needed. Never put the secret or service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# true: fictional names for every real chama and no real ledger photo on any
# page (ground rule G5, D-028). Use it on any projector.
DEMO_MODE=false
# Where uploaded ledger photos are kept, outside every web folder. Empty:
# data/interim/uploads (private, never committed).
PHOTO_DIR=
# Leave true. Set false only to try the site from a phone over plain http on
# the local network (browsers refuse Secure cookies there).
COOKIE_SECURE=true
# The addresses the pages are opened from, comma-separated (changes from any
# other site are refused).
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# How long a sign-in lasts.
SESSION_HOURS=12
# Officials confirm every sign-in with a code texted to their phone (D-037).
# Set false only for development on this laptop.
TWO_STEP_FOR_OFFICIALS=true
# Phone numbers written as 07... or 01... are read in this country (Kenya).
PHONE_COUNTRY_CODE=254

# Texting the sign-in codes through Africa's Talking (D-042; docs/web_setup.md).
# Supabase calls Kibaba's /api/hooks/send-sms with each code; Kibaba texts it.
# From Supabase (Authentication > Hooks > Send SMS hook): v1,whsec_...
SMS_HOOK_SECRET=
# Your Africa's Talking app's username ("sandbox" for the free test environment)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional: a sender name Africa's Talking has approved for you (empty: their default)
AFRICASTALKING_SENDER_ID=

# The officials' text the day before each meeting (D-045), through the same
# Africa's Talking app: how many members to follow up, never their names.
# The meeting day is `meets` in config/pipeline.yaml. Switch it on in one copy
# of the site only (the laptop release or the Space), or officials get it twice.
MEETING_TEXTS=false
# The hour, Nairobi time, from which the text goes on the day before (0-23)
MEETING_TEXT_HOUR=9

# ---- The cloud release (docs/deployment.md, D-032) ----
# Write token: lets deploy-publish create the dataset and Space.
HF_TOKEN=
# Read-only token: lets the Space's build fetch the private dataset.
HF_BUILD_TOKEN=
# GitHub fine-grained token, read-only, this repository only: lets the build clone the code.
GITHUB_READ_TOKEN=
# The release's own key, different from PSEUDONYM_KEY. Keep it once made.
CLOUD_PSEUDONYM_KEY=
# The release's two accounts (D-036): the treasurer, Alvin Muriithi, and a
# member, Alvin Wise. The treasurer's phone gets each sign-in's code (D-037);
# the member's phone is optional, for signing in with a code.
RELEASE_OFFICIAL_EMAIL=
RELEASE_OFFICIAL_PHONE=
RELEASE_MEMBER_EMAIL=
RELEASE_MEMBER_PHONE=
