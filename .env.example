# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_USER=chama
POSTGRES_PASSWORD=
POSTGRES_DB=chama
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Secret key used to turn member names into codes.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_KEY=

# The project folder on Google Drive, as synced by Drive for desktop, e.g.
# DRIVE_DIR=G:/My Drive/chama-loan-default
# `export` writes the modelling table to its data/ folder and training logs
# MLflow runs to its mlruns/ folder. Left empty: data/processed and ./mlruns.
DRIVE_DIR=

# Keys for reading ledger photos (extract, extract-eval; D-025). Only the
# provider set in config/pipeline.yaml (extraction.provider) needs one.
# Groq, free plan (the default): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Claude API, paid (for comparison): https://platform.claude.com, under API keys
ANTHROPIC_API_KEY=
